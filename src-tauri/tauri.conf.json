{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MG Canvas",
  "identifier": "app.mgcanvas.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:assets",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MG Canvas · 绘图工作台",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["workbench"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; form-action 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../THIRD-PARTY-RUST.txt": "THIRD-PARTY-RUST.txt"
    },
    "fileAssociations": [{
      "ext": ["mgcanvas"],
      "name": "MGCanvas.Project",
      "description": "MG Canvas 画板"
    }],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/installer-hooks.nsh" },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
